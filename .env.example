# ---------------------------------------------------------------------------
# Copy to .env for local development. In production these are Fly secrets
# (`fly secrets set ...`), never a committed file.
# ---------------------------------------------------------------------------

# Postgres. Set by `fly mpg attach` in production; point it at a local
# container when developing (see DEPLOY.md).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/study1

# Researcher access to /admin, /preview and every /api/export/* endpoint.
# Generate with:  openssl rand -base64 32
ADMIN_TOKEN=

# Salt for the one-way IP hash used only to spot duplicate submissions.
# Set once and never rotate: changing it makes old hashes uncomparable.
IP_SALT=

# --- design ---------------------------------------------------------------
# on | off | random — whether the optional attitude block (NARS + SCM) runs.
OPTIONAL_BLOCK=on

# Set to false to stop new participants starting. Anyone already in progress
# can still finish. Takes effect on `fly secrets set`, no redeploy needed.
STUDY_OPEN=true

# --- recruitment ----------------------------------------------------------
# cloudresearch | prolific | mturk | direct
RECRUITMENT=cloudresearch

# CloudResearch Connect: the Redirect URL from the end of the Create a Study
# wizard. Leave blank to show only a completion code.
COMPLETION_REDIRECT_URL=

# Fixed completion code shown on the final page. Leave blank to give each
# participant their own unique code instead (recommended: it lets you match a
# platform submission to a row in the database).
COMPLETION_CODE=

# --- participant-facing ---------------------------------------------------
CONTACT_EMAIL=
STUDY_INFO_URL=

# --- ops ------------------------------------------------------------------
LOG_LEVEL=info
PG_POOL_MAX=10
RATE_LIMIT_MAX=240
